# Copy this file to `.env` (in this same hw4 folder) and fill in real values.
# `.env` is listed in .gitignore, so it's never uploaded. Never share it.

# Your Portkey API key, used by the chatbot to reach the AI model (gpt-5.6-luna).
PORTKEY_API_KEY=your-portkey-api-key-here

# Signs login cookies. Use a long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false
