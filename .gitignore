# Installed dependencies (recreated by npm install / pip install)
node_modules/
.venv/
__pycache__/

# Build output
frontend/dist/

# Secrets: never commit API keys
.env
.env.*
!.env.example

# The data pack stays on your computer only: campus_customs.db (user emails and
# password hashes) and products/ (the assignment's product photos).
data/

# Temporary files from the audit trail writer
output/*.tmp
output/audit_trail.unreadable-*.json
